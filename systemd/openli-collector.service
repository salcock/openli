[Unit]
Description=OpenLI collector daemon
Documentation=http://github.com/OpenLI-NZ/openli/wiki
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/openlicollector -c /etc/openli/collector-config.yaml
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-abnormal
RestartSec=5s

PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_NICE

[Install]
WantedBy=multi-user.target
